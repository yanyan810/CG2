@echo off
powershell -NoProfile -ExecutionPolicy Bypass -Command "& { $src = 'BattleActionExporter.py'; $baseDir = [Environment]::GetFolderPath('ApplicationData') + '\Blender Foundation\Blender'; if (!(Test-Path $baseDir)) { Write-Host 'Blender dir not found.'; pause; exit; } Get-ChildItem -Path $baseDir -Directory | Where-Object { $_.Name -match '^\d+\.\d+$' } | ForEach-Object { $target = Join-Path $_.FullName 'scripts\addons'; if (!(Test-Path $target)) { New-Item -ItemType Directory -Force -Path $target | Out-Null }; Copy-Item -Path $src -Destination $target -Force; Write-Host ('Copied to ' + $_.Name) }; Write-Host 'Done! Please restart Blender or reload scripts to apply changes.'; pause }"
